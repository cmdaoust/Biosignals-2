# ── User config (copy templates and fill in your paths) ───────────────────────
config.m
config.R
config.py
config.yaml

# ── Raw data (lives in Box, not tracked by git) ───────────────────────────────
**/*.acq
analysis/data/
analysis/followup_schedule.csv
analysis/questionniare_followup_dates.R
# Participant ID keys (real IDs behind the P-codes): must never be committed.
# The interim report keeps its key on Box; these are a safety net.
**/*id_key*
**/*interim_report_private*

# ── R artifacts ───────────────────────────────────────────────────────────────
.Rhistory
.RData
.Rproj.user/
*.Rproj
analysis/.qc_cache/

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── MATLAB artifacts ──────────────────────────────────────────────────────────
*.asv

# Data and manuscripts
manuscripts/
pilot_data/

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
