PSPM_PATH   = 'C:/Program Files/MATLAB/R2026a/pspm';   % e.g. '/its/home/cm909/matlab_toolboxes/PsPM_v7.0.0'

SERVER_ROOT = 'C:/Users/carme/Box/Project_Biosignals_study_2/3_Data';
