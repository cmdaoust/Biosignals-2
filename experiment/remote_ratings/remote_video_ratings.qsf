  {
   "SurveyID": "SV_3kBs2RemRat8wQ",
   "Element": "SQ",
   "PrimaryAttribute": "QID1",
   "SecondaryAttribute": "intro",
   "TertiaryAttribute": null,
   "Payload": {
    "QuestionText": "<p>Thank you again for taking part in our study.</p><p>Your session ended before the final questions about the videos could be shown, so we would be grateful if you could answer them here. It takes about 5 minutes.</p><p>You will see a still image from each of the four videos you watched. For each one, please think back to how you felt <b>while you were watching that video in the lab</b>, and answer the questions.</p><p>Please note that two of the videos contained upsetting content. You only need to see a single still image from each.</p>",
    "DefaultChoices": false,
    "DataExportTag": "intro",
    "QuestionType": "DB",
    "Selector": "TB",
    "Configuration": {
     "QuestionDescriptionOption": "UseText"
    },
    "QuestionDescription": "intro",
    "Validation": {
     "Settings": {
      "Type": "None"
     }
    },
    "GradingData": [],
    "Language": [],
    "NextChoiceId": 4,
    "NextAnswerId": 1,
    "QuestionID": "QID1",
    "ChoiceOrder": []
   }
  },
