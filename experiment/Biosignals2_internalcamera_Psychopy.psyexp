      <CodeComponent name="stim_trigger_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((trigger_name === &quot;Nstim1_trig&quot;)) {&amp;#10;    neg_stim_trigger = neg_stim1_trigger;&amp;#10;} else {&amp;#10;    if ((trigger_name === &quot;Nstim2_trig&quot;)) {&amp;#10;        neg_stim_trigger = neg_stim2_trigger;&amp;#10;    }&amp;#10;}&amp;#10;if ((trigger_name === &quot;Pstim1_trig&quot;)) {&amp;#10;    pos_stim_trigger = pos_stim1_trigger;&amp;#10;} else {&amp;#10;    if ((trigger_name === &quot;Pstim2_trig&quot;)) {&amp;#10;        pos_stim_trigger = pos_stim2_trigger;&amp;#10;    }&amp;#10;}&amp;#10;stimulus_trigger_sent = false;&amp;#10;stimulus_trigger_cleared = false;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="#----&amp;#10;# Log time for camera&amp;#10;# ---&amp;#10;thisExp.addData('onset_wall', time.time())&amp;#10;thisExp.addData('time_since_recording_start', time.time() - experiment_start_wall)&amp;#10;&amp;#10;if trigger_name == 'Nstim1_trig':&amp;#10;    neg_stim_trigger = neg_stim1_trigger&amp;#10;elif trigger_name == 'Nstim2_trig':&amp;#10;     neg_stim_trigger = neg_stim2_trigger&amp;#10;if trigger_name == 'Pstim1_trig':&amp;#10;    pos_stim_trigger = pos_stim1_trigger&amp;#10;elif trigger_name == 'Pstim2_trig':&amp;#10;    pos_stim_trigger = pos_stim2_trigger    &amp;#10;&amp;#10;&amp;#10;stimulus_trigger_sent = False&amp;#10;stimulus_trigger_cleared = False" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="# Set trigger value based on condition&amp;#10;if stim_condition == 'negative':&amp;#10;    stim_trigger = neg_stim_trigger&amp;#10;elif stim_condition == 'positive':&amp;#10;    stim_trigger = pos_stim_trigger&amp;#10;&amp;#10;# --- Stimulus ON ---&amp;#10;if video.status == STARTED and not stimulus_trigger_sent:&amp;#10;    win.callOnFlip(ser.write, str.encode(stim_trigger))&amp;#10;    stimulus_trigger_sent = True&amp;#10;&amp;#10;# --- Stimulus OFF ---&amp;#10;if video.status == FINISHED and not stimulus_trigger_cleared:&amp;#10;    win.callOnFlip(ser.write, str.encode('00'))&amp;#10;    ser.write('RR'.encode('utf-8'))&amp;#10;    stimulus_trigger_cleared = True&amp;#10;&amp;#10;&amp;#10;            " valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if ((stim_condition === &quot;negative&quot;)) {&amp;#10;    if (((video.status === PsychoJS.Status.STARTED) &amp;&amp; (! stimulus_trigger_sent))) {&amp;#10;        psychoJS.window.callOnFlip(ser.write, str.encode(neg_stim_trigger));&amp;#10;        ws_send(`${neg_stim_trigger}, ${trigger_name}`);&amp;#10;        stimulus_trigger_sent = true;&amp;#10;    }&amp;#10;    if (((video.status === PsychoJS.Status.FINISHED) &amp;&amp; (! stimulus_trigger_cleared))) {&amp;#10;        psychoJS.window.callOnFlip(ser.write, str.encode(&quot;00&quot;));&amp;#10;        ser.write(&quot;RR&quot;.encode(&quot;utf-8&quot;));&amp;#10;        ws_send(`00, ${trigger_name}`);&amp;#10;        stimulus_trigger_cleared = true;&amp;#10;    }&amp;#10;} else {&amp;#10;    if ((stim_condition === &quot;positive&quot;)) {&amp;#10;        if (((video.status === PsychoJS.Status.STARTED) &amp;&amp; (! stimulus_trigger_sent))) {&amp;#10;            psychoJS.window.callOnFlip(ser.write, str.encode(pos_stim_trigger));&amp;#10;            ws_send(`${pos_stim_trigger}, ${trigger_name}`);&amp;#10;            stimulus_trigger_sent = true;&amp;#10;        }&amp;#10;        if (((video.status === PsychoJS.Status.FINISHED) &amp;&amp; (! stimulus_trigger_cleared))) {&amp;#10;            psychoJS.window.callOnFlip(ser.write, str.encode(&quot;00&quot;));&amp;#10;            ser.write(&quot;RR&quot;.encode(&quot;utf-8&quot;));&amp;#10;            ws_send(`00, ${trigger_name}`);&amp;#10;            stimulus_trigger_cleared = true;&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;while ((! ws_incoming.empty())) {&amp;#10;    try {&amp;#10;        msg = ws_incoming.get_nowait();&amp;#10;    } catch(e) {&amp;#10;        if ((e instanceof queue.Empty)) {&amp;#10;            break;&amp;#10;        } else {&amp;#10;            throw e;&amp;#10;        }&amp;#10;    }&amp;#10;    text = msg.get(&quot;text&quot;, &quot;&quot;);&amp;#10;    msg_type = msg.get(&quot;type&quot;, &quot;recv&quot;);&amp;#10;    console.log(`[ws ${msg_type}] ${text}`);&amp;#10;    psychoJS.experiment.addData(`ws_${msg_type}`, text);&amp;#10;    psychoJS.experiment.addData(&quot;ws_recv_time&quot;, globalClock.getTime());&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="ser.write(&quot;RR&quot;.encode(&quot;utf-8&quot;));&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="ser.write ('RR'.encode('utf-8'))" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="stim_trigger_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
