      <CodeComponent name="stim_arousal_rating_code_2" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="stim_arousal_mouse.setVisible(true);&amp;#10;timer = null;&amp;#10;image_id = screenshot_path;&amp;#10;intensityQuestion.setAutoDraw(false);&amp;#10;intensitySlider.setAutoDraw(false);&amp;#10;intensitySlider_txt_very_intense.setAutoDraw(false);&amp;#10;intensitySlider_txt_not_intense.setAutoDraw(false);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="stim_arousal_mouse.setVisible(True)&amp;#10;timer = None&amp;#10;&amp;#10;# set the path to the image shown so that it is identical to what was presented on the previous trial&amp;#10;image_id = screenshot_path&amp;#10;&amp;#10;&amp;#10;intensityQuestion.setAutoDraw(False)&amp;#10;intensitySlider.setAutoDraw(False)&amp;#10;intensitySlider_txt_very_intense.setAutoDraw(False)&amp;#10;intensitySlider_txt_not_intense.setAutoDraw(False)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="if len(emotionText.text.strip()) &gt; 0:&amp;#10;    intensityQuestion.setAutoDraw(True)&amp;#10;    intensitySlider.setAutoDraw(True)&amp;#10;    intensitySlider_txt_very_intense.setAutoDraw(True)&amp;#10;intensitySlider_txt_not_intense.setAutoDraw(True)&amp;#10;&amp;#10;if intensitySlider.getRating() is not None:&amp;#10;    if timer is None:&amp;#10;        timer = core.CountdownTimer(2)&amp;#10;&amp;#10;    if timer.getTime() &lt; 0:&amp;#10;        continueRoutine = False" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if ((emotionText.text.strip().length &gt; 0)) {&amp;#10;    intensityQuestion.setAutoDraw(true);&amp;#10;    intensitySlider.setAutoDraw(true);&amp;#10;    intensitySlider_txt_very_intense.setAutoDraw(true);&amp;#10;}&amp;#10;intensitySlider_txt_not_intense.setAutoDraw(true);&amp;#10;if ((intensitySlider.getRating() !== null)) {&amp;#10;    if ((timer === null)) {&amp;#10;        timer = new core.CountdownTimer(2);&amp;#10;    }&amp;#10;    if ((timer.getTime() &lt; 0)) {&amp;#10;        continueRoutine = false;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="stim_arousal_mouse.setVisible(false);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="stim_arousal_mouse.setVisible(False)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="stim_arousal_rating_code_2" valType="code" updates="None" name="name"/>
