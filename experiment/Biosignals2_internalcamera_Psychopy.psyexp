      <Param name="name" updates="None" val="experimental_conditions" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <LoopInitiator loopType="TrialHandler" name="stim_block_and_ratings">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="stim_block_and_ratings" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="block_setup"/>
    <Routine name="video_instruct"/>
    <LoopInitiator loopType="TrialHandler" name="stim_block">
      <Param name="Selected rows" updates="None" val="0:4" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('neg_stim_path', 'stimuli/N007.mp4'), ('neg_youtube_codes', '2xd-CA48TuY'), ('neg_video_name', 'N007'), ('trigger_name', 'Nstim1_trig'), ('neg_description', 'Stork throws immature baby away'), ('neg_valence', 'Negative'), ('neg_duration', '01:03')]), OrderedDict([('neg_stim_path', 'stimuli/N01.mp4'), ('neg_youtube_codes', 'wVa_PukAmFs&amp;list=PLPq7fQ0Sjj3v8UNgx1HvBB47sgNJftorN'), ('neg_video_name', 'N01'), ('trigger_name', 'Nstim2_trig'), ('neg_description', 'Man euthanises dog'), ('neg_valence', 'Negative'), ('neg_duration', '01:48')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="$stim_file" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="stim_block" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
