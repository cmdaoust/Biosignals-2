        <Param val="stimuli_affect_rating" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="affect_rating_code" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="import random&amp;#10;&amp;#10;# possible slider positions&amp;#10;top_slider_pos = (0, -0.1)&amp;#10;bottom_slider_pos = (0, -0.25)&amp;#10;&amp;#10;# possible slider label positions&amp;#10;top_left_label = (-0.7, -0.15)&amp;#10;top_right_label = (0.7, -0.15)&amp;#10;bottom_left_label = (-0.7, -0.3)&amp;#10;bottom_right_label = (0.7, -0.3)" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="import * as random from 'random';&amp;#10;top_slider_pos = [0, (- 0.1)];&amp;#10;bottom_slider_pos = [0, (- 0.25)];&amp;#10;top_left_label = [(- 0.7), (- 0.15)];&amp;#10;top_right_label = [0.7, (- 0.15)];&amp;#10;bottom_left_label = [(- 0.7), (- 0.3)];&amp;#10;bottom_right_label = [0.7, (- 0.3)];&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="stim_affect_mouse.setVisible(true);&amp;#10;timer = null;&amp;#10;image_id = screenshot_path;&amp;#10;if ((video_rating.thisN === 0)) {&amp;#10;    stim_slider_orders = (([&quot;valence_first&quot;] * 2) + ([&quot;arousal_first&quot;] * 2));&amp;#10;    Math.random.shuffle(stim_slider_orders);&amp;#10;    order_index = 0;&amp;#10;}&amp;#10;questionOrder = stim_slider_orders[order_index];&amp;#10;order_index += 1;&amp;#10;if ((questionOrder === &quot;valence_first&quot;)) {&amp;#10;    stim_valence_slider_pos = top_slider_pos;&amp;#10;    stim_pleasant_txt_pos = top_right_label;&amp;#10;    stim_unpleasant_txt_pos = top_left_label;&amp;#10;    stim_arousal_slider_pos = bottom_slider_pos;&amp;#10;    stim_alert_txt_pos = bottom_right_label;&amp;#10;    stim_notalert_txt_pos = bottom_left_label;&amp;#10;} else {&amp;#10;    stim_arousal_slider_pos = top_slider_pos;&amp;#10;    stim_alert_txt_pos = top_right_label;&amp;#10;    stim_notalert_txt_pos = top_left_label;&amp;#10;    stim_valence_slider_pos = bottom_slider_pos;&amp;#10;    stim_pleasant_txt_pos = bottom_right_label;&amp;#10;    stim_unpleasant_txt_pos = bottom_left_label;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="stim_affect_mouse.setVisible(True)&amp;#10;timer = None&amp;#10;&amp;#10;# set the path to the image shown so that it is identical to what was presented on the previous trial&amp;#10;image_id = screenshot_path&amp;#10;&amp;#10;# Only run this on the FIRST trial of the loop&amp;#10;if video_rating.thisN == 0:&amp;#10;    stim_slider_orders = [&quot;valence_first&quot;] * 2 + [&quot;arousal_first&quot;] * 2&amp;#10;    random.shuffle(stim_slider_orders)&amp;#10;    order_index = 0&amp;#10;&amp;#10;# Get the order for THIS trial&amp;#10;questionOrder = stim_slider_orders[order_index]&amp;#10;order_index += 1&amp;#10;&amp;#10;if questionOrder == &quot;valence_first&quot;:&amp;#10;    # Valence on top&amp;#10;    stim_valence_slider_pos = top_slider_pos&amp;#10;    stim_pleasant_txt_pos = top_right_label&amp;#10;    stim_unpleasant_txt_pos = top_left_label&amp;#10;&amp;#10;    stim_arousal_slider_pos = bottom_slider_pos&amp;#10;    stim_alert_txt_pos = bottom_right_label&amp;#10;    stim_notalert_txt_pos = bottom_left_label&amp;#10;&amp;#10;else:&amp;#10;    # Arousal on top&amp;#10;    stim_arousal_slider_pos = top_slider_pos&amp;#10;    stim_alert_txt_pos = top_right_label&amp;#10;    stim_notalert_txt_pos = top_left_label&amp;#10;&amp;#10;    stim_valence_slider_pos = bottom_slider_pos&amp;#10;    stim_pleasant_txt_pos = bottom_right_label&amp;#10;    stim_unpleasant_txt_pos = bottom_left_label&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="if (valence_slider.getRating() is not None&amp;#10;    and arousal_slider.getRating() is not None):&amp;#10;&amp;#10;    if timer is None:&amp;#10;        timer = core.CountdownTimer(2)&amp;#10;&amp;#10;    if timer.getTime() &lt; 0:&amp;#10;        continueRoutine = False" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (((valence_slider.getRating() !== null) &amp;&amp; (arousal_slider.getRating() !== null))) {&amp;#10;    if ((timer === null)) {&amp;#10;        timer = new core.CountdownTimer(2);&amp;#10;    }&amp;#10;    if ((timer.getTime() &lt; 0)) {&amp;#10;        continueRoutine = false;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="stim_affect_mouse.setVisible(false);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="stim_affect_mouse.setVisible(False)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="affect_rating_code" valType="code" updates="None" name="name"/>
      </CodeComponent>
