        <Param val="block_count = (block_count + 1);&amp;#10;if ((condition_order === &quot;pos_first&quot;)) {&amp;#10;    if ((block_count === 1)) {&amp;#10;        stim_file = &quot;positive_stim.csv&quot;;&amp;#10;        stim_condition = &quot;positive&quot;;&amp;#10;    } else {&amp;#10;        if ((block_count === 2)) {&amp;#10;            stim_file = &quot;negative_stim.csv&quot;;&amp;#10;            stim_condition = &quot;negative&quot;;&amp;#10;        }&amp;#10;    }&amp;#10;} else {&amp;#10;    if ((condition_order === &quot;neg_first&quot;)) {&amp;#10;        if ((block_count === 1)) {&amp;#10;            stim_file = &quot;negative_stim.csv&quot;;&amp;#10;            stim_condition = &quot;negative&quot;;&amp;#10;        } else {&amp;#10;            if ((block_count === 2)) {&amp;#10;                stim_file = &quot;positive_stim.csv&quot;;&amp;#10;                stim_condition = &quot;positive&quot;;&amp;#10;            }&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="block_count = block_count +1&amp;#10;&amp;#10;if condition_order == 'pos_first':&amp;#10;    if block_count == 1:&amp;#10;        stim_file = 'positive_stim.csv'&amp;#10;        stim_condition = 'positive'&amp;#10;    elif block_count == 2:&amp;#10;        stim_file = 'negative_stim.csv'&amp;#10;        stim_condition = 'negative'&amp;#10;elif condition_order == 'neg_first':&amp;#10;    if block_count == 1:&amp;#10;        stim_file = 'negative_stim.csv'&amp;#10;        stim_condition = 'negative'&amp;#10;    elif block_count == 2:&amp;#10;        stim_file = 'positive_stim.csv'&amp;#10;        stim_condition = 'positive'" valType="extendedCode" updates="constant" name="Begin Routine"/>
