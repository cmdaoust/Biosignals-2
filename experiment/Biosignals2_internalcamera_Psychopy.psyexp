    <Routine name="momentary_valence_rating_A"/>
    <Routine name="momentary_arousal_rating"/>
    <Routine name="momentary_valence_rating_B"/>
    <LoopTerminator name="post_emotion_recovery_ratings"/>
    <LoopTerminator name="experimental_conditions"/>
    <Routine name="stim_rating_instruct"/>
    <LoopInitiator loopType="TrialHandler" name="video_rating">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('screenshot_path', 'stimuli/N007_screenshot.png'), ('origional_video_id', 'N007')]), OrderedDict([('screenshot_path', 'stimuli/N01_screenshot.png'), ('origional_video_id', 'N01')]), OrderedDict([('screenshot_path', 'stimuli/P02_screenshot.png'), ('origional_video_id', 'P02')]), OrderedDict([('screenshot_path', 'stimuli/P0141_screenshot.png'), ('origional_video_id', 'P0141')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="rating_images.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="video_rating" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="stimuli_emo_rating"/>
    <Routine name="stimuli_valence_rating_A"/>
    <Routine name="stimuli_arousal_rating"/>
    <Routine name="stimuli_valence_rating_B"/>
    <Routine name="approach_rating"/>
    <LoopTerminator name="video_rating"/>
    <Routine name="end"/>
  </Flow>
</PsychoPy2experiment>
