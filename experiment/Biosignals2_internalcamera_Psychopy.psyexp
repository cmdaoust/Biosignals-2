        <Param val="momentary_arousal_mouse.setVisible(true);&amp;#10;timer = null;&amp;#10;condition = stim_condition;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="momentary_arousal_mouse.setVisible(True)&amp;#10;timer = None&amp;#10;&amp;#10;condition = stim_condition" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
